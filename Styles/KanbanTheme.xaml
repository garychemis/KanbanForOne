<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:KanbanForOne.Converters">
    <converters:TaskStatusBrushConverter x:Key="TaskStatusBrushConverter" />
    <converters:TaskStatusBackgroundConverter x:Key="TaskStatusBackgroundConverter" />
    <converters:TaskStatusDrawerBackgroundConverter x:Key="TaskStatusDrawerBackgroundConverter" />
    <converters:TaskStatusNameConverter x:Key="TaskStatusNameConverter" />
    <converters:TaskPriorityBrushConverter x:Key="TaskPriorityBrushConverter" />
    <converters:TaskPriorityNameConverter x:Key="TaskPriorityNameConverter" />
    <converters:TaskPreviewSegmentBrushConverter x:Key="TaskPreviewSegmentBrushConverter" />
    <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
    <converters:DoneTextDecorationConverter x:Key="DoneTextDecorationConverter" />
    <converters:DoneForegroundConverter x:Key="DoneForegroundConverter" />
    <converters:DateDisplayConverter x:Key="DateDisplayConverter" />
    <converters:AttachmentSizeConverter x:Key="AttachmentSizeConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <converters:BooleanToVisibilityConverterEx x:Key="BooleanToVisibilityConverterEx" />
    <converters:FilterSelectedBackgroundConverter x:Key="FilterSelectedBackgroundConverter" />
    <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter" />
    <converters:TagDisplayConverter x:Key="TagDisplayConverter" />
    <converters:TagListDisplayConverter x:Key="TagListDisplayConverter" />
    <converters:SizeMultiplierConverter x:Key="SizeMultiplierConverter" />

    <!-- Low-saturation palette for long desktop sessions. -->
    <Color x:Key="BrandNavyColor">#283D38</Color>
    <Color x:Key="BrandNavyHoverColor">#3C655A</Color>
    <Color x:Key="BrandNavyPressedColor">#294B42</Color>
    <Color x:Key="BrandTealColor">#527D70</Color>
    <Color x:Key="BrandPaperColor">#F7F8F5</Color>
    <Color x:Key="NoteCardBackgroundColor">#FFF5CF</Color>
    <Color x:Key="BlockedCardBackgroundColor">#FAEEEC</Color>
    <Color x:Key="BlockedCardBorderColor">#E4D3CF</Color>
    <Color x:Key="BlockedCardTextColor">#8E514B</Color>

    <!-- Semantic surfaces and states shared by every workspace and editor. -->
    <SolidColorBrush x:Key="BrandNavyBrush" Color="{StaticResource BrandNavyColor}" />
    <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTealColor}" />
    <SolidColorBrush x:Key="BrandPaperBrush" Color="{StaticResource BrandPaperColor}" />
    <SolidColorBrush x:Key="BrandTealTintBrush" Color="#E3EDE9" />
    <SolidColorBrush x:Key="WorkHourModuleTintBrush" Color="#F8F5EF" />
    <SolidColorBrush x:Key="WorkHourModuleHoverBrush" Color="#F3EDE3" />
    <SolidColorBrush x:Key="WorkHourModuleBorderBrush" Color="#E5DAC9" />
    <SolidColorBrush x:Key="WorkHourModuleTextBrush" Color="#6D604C" />
    <SolidColorBrush x:Key="DesignConditionModuleTintBrush" Color="#F1F7F5" />
    <SolidColorBrush x:Key="DesignConditionModuleHoverBrush" Color="#EAF3F0" />
    <SolidColorBrush x:Key="DesignConditionModuleBorderBrush" Color="#D0E1DC" />
    <SolidColorBrush x:Key="DesignConditionModuleTextBrush" Color="#4B7068" />
    <SolidColorBrush x:Key="ArchiveModuleTintBrush" Color="#F4EFE6" />
    <SolidColorBrush x:Key="ArchiveModuleHoverBrush" Color="#EFE7D9" />
    <SolidColorBrush x:Key="ArchiveModuleBorderBrush" Color="#E0D5C0" />
    <SolidColorBrush x:Key="ArchiveModuleTextBrush" Color="#6E6250" />
    <SolidColorBrush x:Key="ArchiveColumnBackgroundBrush" Color="#F5F3ED" />
    <SolidColorBrush x:Key="ArchiveCardTintBrush" Color="#F8F5EC" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F3EF" />
    <SolidColorBrush x:Key="MainContentBackgroundBrush" Color="#F1F3EF" />
    <SolidColorBrush x:Key="SideNavBackgroundBrush" Color="{StaticResource BrandPaperColor}" />
    <SolidColorBrush x:Key="TopNavBackgroundBrush" Color="#F8F9F6" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource BrandNavyColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#65716C" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#DEE4DD" />
    <SolidColorBrush x:Key="TaskCardBorderBrush" Color="#D2DCD3" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#E3EDE9" />
    <SolidColorBrush x:Key="ColumnBackgroundBrush" Color="#F6F7F3" />
    <SolidColorBrush x:Key="NoteCardBackgroundBrush" Color="{StaticResource NoteCardBackgroundColor}" />
    <SolidColorBrush x:Key="NoteCardBorderBrush" Color="#E5D9A8" />
    <SolidColorBrush x:Key="NoteCardHoverBorderBrush" Color="#C5B16A" />
    <SolidColorBrush x:Key="NoteCardTextPrimaryBrush" Color="#514620" />
    <SolidColorBrush x:Key="NoteCardTextSecondaryBrush" Color="#776A3B" />
    <SolidColorBrush x:Key="BlockedCardBackgroundBrush" Color="{StaticResource BlockedCardBackgroundColor}" />
    <SolidColorBrush x:Key="BlockedCardBorderBrush" Color="{StaticResource BlockedCardBorderColor}" />
    <SolidColorBrush x:Key="BlockedCardHoverBorderBrush" Color="#C2968F" />
    <SolidColorBrush x:Key="BlockedCardAccentBrush" Color="#AE6D66" />
    <SolidColorBrush x:Key="BlockedCardTextBrush" Color="{StaticResource BlockedCardTextColor}" />
    <SolidColorBrush x:Key="BlockedCardSecondaryBrush" Color="#626D67" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FDFDF9" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EBF0EA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#426D5E" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource BrandNavyHoverColor}" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource BrandNavyPressedColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#A8B3AB" />

    <!-- Shared interaction and spacing tokens. -->
    <SolidColorBrush x:Key="DangerBrush" Color="#A34F59" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="#F8ECEB" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#EBD4D3" />
    <Thickness x:Key="PageSpacing">24</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <Style x:Key="KeyboardFocusStyle" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
            <Border Margin="2" BorderBrush="{StaticResource BrandTealBrush}" BorderThickness="1" CornerRadius="4" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="AppNumericFontFamily">Cascadia Mono, Consolas, Segoe UI</FontFamily>
    <FontFamily x:Key="AppIconFontFamily">Segoe MDL2 Assets</FontFamily>

    <Style x:Key="AppBrandTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppPageTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppPageSubtitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="AppSectionTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppBodyTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="AppBodyStrongTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource AppBodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppLabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="AppMetaTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="AppNumericTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AppNumericFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="AppMetricValueTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource AppNumericTextStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Opacity" Value="0.72" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource FilterSelectedBackgroundConverter}"
                                          ConverterParameter="#E3EDE9|#00FFFFFF">
                                <Binding Path="DataContext.CurrentFilter"
                                         RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="CommandParameter"
                                         RelativeSource="{RelativeSource TemplatedParent}" />
                            </MultiBinding>
                        </Border.Background>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextInputStyle" TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrandTealBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
    </Style>

    <Style x:Key="ListCardButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.82" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
