<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:KanbanForOne.Converters">
    <converters:TaskStatusBrushConverter x:Key="TaskStatusBrushConverter" />
    <converters:TaskStatusBackgroundConverter x:Key="TaskStatusBackgroundConverter" />
    <converters:TaskStatusDrawerBackgroundConverter x:Key="TaskStatusDrawerBackgroundConverter" />
    <converters:TaskStatusNameConverter x:Key="TaskStatusNameConverter" />
    <converters:TaskPriorityBrushConverter x:Key="TaskPriorityBrushConverter" />
    <converters:TaskPriorityNameConverter x:Key="TaskPriorityNameConverter" />
    <converters:TaskPreviewSegmentBrushConverter x:Key="TaskPreviewSegmentBrushConverter" />
    <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
    <converters:DoneTextDecorationConverter x:Key="DoneTextDecorationConverter" />
    <converters:DoneForegroundConverter x:Key="DoneForegroundConverter" />
    <converters:DateDisplayConverter x:Key="DateDisplayConverter" />
    <converters:AttachmentSizeConverter x:Key="AttachmentSizeConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <converters:BooleanToVisibilityConverterEx x:Key="BooleanToVisibilityConverterEx" />
    <converters:FilterSelectedBackgroundConverter x:Key="FilterSelectedBackgroundConverter" />
    <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter" />
    <converters:TagDisplayConverter x:Key="TagDisplayConverter" />
    <converters:TagListDisplayConverter x:Key="TagListDisplayConverter" />
    <converters:SizeMultiplierConverter x:Key="SizeMultiplierConverter" />

    <!-- Primitive brand colors: shared with icon/kanban41.svg. -->
    <Color x:Key="BrandNavyColor">#172730</Color>
    <Color x:Key="BrandNavyHoverColor">#223B46</Color>
    <Color x:Key="BrandNavyPressedColor">#0F1F27</Color>
    <Color x:Key="BrandTealColor">#5C9187</Color>
    <Color x:Key="BrandPaperColor">#F7F6F1</Color>

    <!-- Semantic surfaces and states derived from the icon palette. -->
    <SolidColorBrush x:Key="BrandNavyBrush" Color="{StaticResource BrandNavyColor}" />
    <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTealColor}" />
    <SolidColorBrush x:Key="BrandPaperBrush" Color="{StaticResource BrandPaperColor}" />
    <SolidColorBrush x:Key="BrandTealTintBrush" Color="#DDEAE7" />
    <SolidColorBrush x:Key="WorkHourModuleTintBrush" Color="#F8F5EF" />
    <SolidColorBrush x:Key="WorkHourModuleHoverBrush" Color="#F3EDE3" />
    <SolidColorBrush x:Key="WorkHourModuleBorderBrush" Color="#E5DAC9" />
    <SolidColorBrush x:Key="WorkHourModuleTextBrush" Color="#6D604C" />
    <SolidColorBrush x:Key="DesignConditionModuleTintBrush" Color="#F1F7F5" />
    <SolidColorBrush x:Key="DesignConditionModuleHoverBrush" Color="#EAF3F0" />
    <SolidColorBrush x:Key="DesignConditionModuleBorderBrush" Color="#D0E1DC" />
    <SolidColorBrush x:Key="DesignConditionModuleTextBrush" Color="#4B7068" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EDF1F0" />
    <SolidColorBrush x:Key="MainContentBackgroundBrush" Color="#EDF1F0" />
    <SolidColorBrush x:Key="SideNavBackgroundBrush" Color="{StaticResource BrandPaperColor}" />
    <SolidColorBrush x:Key="TopNavBackgroundBrush" Color="#F8F9F7" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource BrandNavyColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#647279" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#D7DEDC" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#DDEAE7" />
    <SolidColorBrush x:Key="ColumnBackgroundBrush" Color="#40F8FAFC" />
    <SolidColorBrush x:Key="NoteCardBackgroundBrush" Color="#FFF8B7" />
    <SolidColorBrush x:Key="NoteCardBorderBrush" Color="#F7E98A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFCFA" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E8EFED" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BrandNavyColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource BrandNavyHoverColor}" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource BrandNavyPressedColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#AAB5B3" />

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="AppNumericFontFamily">Cascadia Mono, Consolas, Segoe UI</FontFamily>
    <FontFamily x:Key="AppIconFontFamily">Segoe MDL2 Assets</FontFamily>

    <Style x:Key="AppBrandTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppPageTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppPageSubtitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="AppSectionTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppBodyTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="AppBodyStrongTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource AppBodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AppLabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="AppMetaTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="AppNumericTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AppNumericFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="AppMetricValueTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource AppNumericTextStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ButtonPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Opacity" Value="0.72" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            CornerRadius="7">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource FilterSelectedBackgroundConverter}"
                                          ConverterParameter="#DDEAE7|#00FFFFFF">
                                <Binding Path="DataContext.CurrentFilter"
                                         RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="CommandParameter"
                                         RelativeSource="{RelativeSource TemplatedParent}" />
                            </MultiBinding>
                        </Border.Background>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextInputStyle" TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrandTealBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="5"
                                  Direction="270"
                                  Opacity="0.07" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListCardButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.82" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
