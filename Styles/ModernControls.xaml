<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Native popup controls share the same quiet selection palette. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E3EDE9" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#283D38" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F7F8F5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#DEE4DD" />
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control" BasedOn="{StaticResource KeyboardFocusStyle}" />
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <!-- A 12-DIP hit target with a narrow visible thumb; both orientations retain
         native keyboard, wheel and page-click behavior through PART_Track. -->
    <Style x:Key="MinimalScrollRepeatStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MinimalScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Background" Value="#C3CFC5" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="3" />
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#8B9E90" /></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{StaticResource BrandTealBrush}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource MinimalScrollRepeatStyle}" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinHeight="24" Style="{StaticResource MinimalScrollThumbStyle}" /></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource MinimalScrollRepeatStyle}" /></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource MinimalScrollRepeatStyle}" /></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb MinWidth="24" Style="{StaticResource MinimalScrollThumbStyle}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource MinimalScrollRepeatStyle}" /></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
