<UserControl x:Class="KanbanForOne.Controls.SearchBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="200"
             Height="38" Style="{StaticResource {x:Type UserControl}}">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrandTealBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="&#xE721;"
                       FontFamily="Segoe MDL2 Assets"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />

            <TextBox Grid.Column="1"
                     x:Name="SearchInput"
                     AutomationProperties.Name="搜索任务"
                     Height="28"
                     Padding="0,1,0,0"
                     BorderThickness="0"
                     Background="Transparent"
                     FontSize="13"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalContentAlignment="Center"
                     Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Text="搜索任务…" IsHitTestVisible="False" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Column="2"
                    Content="&#xE711;"
                    FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource IconButtonStyle}"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="OnClearClick"
                    ToolTip="&#x6E05;&#x7A7A;&#x641C;&#x7D22;" />
        </Grid>
    </Border>
</UserControl>
