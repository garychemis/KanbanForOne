<UserControl x:Class="KanbanForOne.Controls.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type UserControl}}">
    <Grid Background="{DynamicResource MainContentBackgroundBrush}">
        <ScrollViewer HorizontalContentAlignment="Stretch"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource PageSpacing}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="52"
                           Height="52"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/KanbanForOne;component/icon/icon-transparent.png"
                           Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="关于 Kanban41"
                                   Style="{StaticResource AppPageTitleTextStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="个人任务、工时与设计条件的本地管理工具"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,22,0,0"
                        Padding="18"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="应用信息"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="版本" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="12" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="版权" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding CopyrightText}" FontSize="12" TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="联系邮箱" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap">
                                <Hyperlink AutomationProperties.Name="发送邮件至 pipingcalculator@163.com"
                                           NavigateUri="mailto:pipingcalculator@163.com"
                                           RequestNavigate="OnExternalLinkRequestNavigate"
                                           Foreground="{DynamicResource BrandTealBrush}"
                                           ToolTip="使用默认邮件客户端发送邮件">
                                    <Run Text="{Binding ContactEmail, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="其他作品" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap">
                                <Hyperlink AutomationProperties.Name="打开其他作品展示网站"
                                           NavigateUri="https://pipingcalculator.site"
                                           RequestNavigate="OnExternalLinkRequestNavigate"
                                           Foreground="{DynamicResource BrandTealBrush}"
                                           ToolTip="使用默认浏览器打开">
                                    <Run Text="{Binding PortfolioUrl, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="18"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="版本日志" FontSize="14" FontWeight="SemiBold" />
                            <Border Grid.Column="1" Padding="8,3" Background="{DynamicResource HoverBrush}" CornerRadius="8">
                                <TextBlock Text="{Binding AppVersion}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding ReleaseNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid>
                                            <Rectangle Width="2" HorizontalAlignment="Center" Fill="{DynamicResource BorderBrushSoft}" />
                                            <Ellipse Width="8" Height="8" Margin="0,5,0,0"
                                                     HorizontalAlignment="Center" VerticalAlignment="Top"
                                                     Fill="{DynamicResource BrandTealBrush}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Version}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Margin="10,1,0,0" Text="{Binding Date}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Ellipse Width="4" Height="4" Margin="0,7,0,0" VerticalAlignment="Top"
                                                                     Fill="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" LineHeight="18"
                                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
