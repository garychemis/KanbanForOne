<Window x:Class="KanbanForOne.Controls.ArchiveSectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择归档分区"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="OnDialogKeyDown" Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#F7F1E5" />
        <SolidColorBrush x:Key="DialogHeaderBrush" Color="#F4EFE6" />
        <SolidColorBrush x:Key="DialogSurfaceHoverBrush" Color="#EFE7D9" />

        <Style x:Key="DialogCloseButtonStyle"
               BasedOn="{StaticResource IconButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource ArchiveModuleTextBrush}" />
        </Style>

        <Style x:Key="ArchiveSectionListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="ArchiveSectionItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ArchiveModuleTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="{StaticResource ArchiveModuleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="8,3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DialogSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BrandTealBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogGhostButtonStyle"
               BasedOn="{StaticResource IconButtonStyle}"
               TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ArchiveModuleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ArchiveModuleTextBrush}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="DialogChrome"
          Margin="18"
          Opacity="0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.96"
                            ScaleY="0.96" />
        </Grid.RenderTransform>

        <Border Background="{StaticResource DialogSurfaceBrush}"
                BorderBrush="{StaticResource ArchiveModuleBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Opacity="0.06" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏（无下横线） -->
                <Grid Grid.Row="0"
                      Margin="20,14,16,12"
                      Background="{StaticResource DialogHeaderBrush}"
                      MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;"
                                       FontFamily="{StaticResource AppIconFontFamily}"
                                       FontSize="14"
                                       Foreground="{StaticResource ArchiveModuleTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="选择归档分区"
                                       Margin="8,0,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ArchiveModuleTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="归档到默认或自定义区域"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource ArchiveModuleTextBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="&#x00D7;"
                            Click="OnCancelClick"
                            Style="{StaticResource DialogCloseButtonStyle}" />
                </Grid>

                <!-- 主体：左列表 + 右操作面板 -->
                <Grid Grid.Row="1"
                      Margin="16,0,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0">
                        <Border Background="#55FFFFFF"
                                BorderBrush="{StaticResource ArchiveModuleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6">
                            <ListBox x:Name="SectionListBox"
                                     MinHeight="204"
                                     MaxHeight="308"
                                     Style="{StaticResource ArchiveSectionListBoxStyle}"
                                     ItemContainerStyle="{StaticResource ArchiveSectionItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Margin="6,0,0,0"
                                                        Padding="5,1"
                                                        CornerRadius="5"
                                                        Background="{StaticResource BrandTealTintBrush}"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverterEx}}">
                                                    <TextBlock Text="默认"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrandTealBrush}" />
                                                </Border>
                                                <Border MinWidth="36"
                                                        Height="18"
                                                        Margin="6,0,0,0"
                                                        Padding="6,0"
                                                        CornerRadius="6"
                                                        Background="{StaticResource ArchiveModuleHoverBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalCount, StringFormat={}{0} 项}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ArchiveModuleTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="新建区域"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ArchiveModuleTextBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="NewSectionText"
                                 Margin="0,0,0,14"
                                 Style="{StaticResource TextInputStyle}"
                                 TextChanged="OnNewSectionTextChanged" />
                        <StackPanel Orientation="Vertical">
                            <Button x:Name="ConfirmButton"
                                    Content="归档"
                                    Click="OnConfirmClick"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="120"
                                    Height="36" />
                            <Button Content="取消"
                                    Click="OnCancelClick"
                                    IsCancel="True"
                                    Style="{StaticResource DialogGhostButtonStyle}"
                                    MinWidth="120"
                                    Height="34"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
