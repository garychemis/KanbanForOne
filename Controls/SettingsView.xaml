<UserControl x:Class="KanbanForOne.Controls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type UserControl}}">
    <UserControl.Resources>

        <Style x:Key="WorkOptionInputShellStyle" TargetType="Border">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkOptionAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WorkOptionTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="11,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
        </Style>

        <Style x:Key="WorkOptionAddButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Margin" Value="0,3,3,3" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="{DynamicResource WorkOptionAccentStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource SettingsActionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource SettingsActionPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource SettingsActionFocusBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource SettingsDisabledSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SettingsDisabledTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkOptionRemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="4,0,-3,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SettingsMutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RemoveChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveChrome" Property="Background" Value="{DynamicResource SettingsRemoveHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SettingsRemoveTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RemoveChrome" Property="Background" Value="{DynamicResource SettingsRemovePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RemoveChrome" Property="BorderBrush" Value="{DynamicResource SettingsRemoveFocusBrush}" />
                                <Setter TargetName="RemoveChrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MainContentBackgroundBrush}">
        <ScrollViewer HorizontalContentAlignment="Stretch"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource PageSpacing}"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="设置"
                           Style="{StaticResource AppPageTitleTextStyle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="当前版本使用本地 SQLite，并在 EXE 所在目录的 data/ 下保存数据。"
                           Margin="0,6,0,22"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <Border Padding="18" Margin="0,0,0,16" CornerRadius="10"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="外观主题" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Theme.PreferenceMessage}" Margin="0,8,12,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="亮色" Command="{Binding Theme.UseLightThemeCommand}"
                                    AutomationProperties.Name="使用亮色主题" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Theme.IsLightTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrandTealBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="暗色" Command="{Binding Theme.UseDarkThemeCommand}"
                                    AutomationProperties.Name="使用暗色主题">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Theme.IsDarkTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrandTealBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="18"
                        CornerRadius="10"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="本地数据位置"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据目录"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DataDirectory}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据库"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DatabasePath}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="附件目录"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AttachmentDirectory}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="备份目录"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding BackupDirectory}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="人工时选项"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding WorkHourOptionsPath}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="设计条件库" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DesignConditionDatabasePath}" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="设计条件文件" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DesignConditionAttachmentDirectory}" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        Margin="0,16,0,0"
                        CornerRadius="10"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="人工时下拉选项"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <Border Grid.Column="1"
                                    Padding="9,4"
                                    Background="{DynamicResource SettingsHintSurfaceBrush}"
                                    BorderBrush="{DynamicResource SettingsHintBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TextBlock Text="JSON 自动同步"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SettingsHintTextBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="专业和工作内容保存在 JSON 配置中；人工时录入时输入的新值也会自动加入。"
                                   Margin="0,6,0,16"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="14"
                                    Background="{DynamicResource WorkOptionPanelBrush}"
                                    BorderBrush="{DynamicResource SettingsGroupBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28"
                                                Height="28"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource SettingsGroupBadgeBrush}"
                                                CornerRadius="6">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SettingsGroupBadgeTextBrush}"
                                                       Text="专" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="专业"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="人工时所属的工程专业"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding WorkDisciplines.Count, StringFormat={}{0} 项}" />
                                    </Grid>

                                    <Border Margin="0,13,0,12"
                                            Style="{StaticResource WorkOptionInputShellStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewDisciplineTextBox"
                                                     AutomationProperties.Name="新增人工时专业选项"
                                                     Text="{Binding NewWorkDiscipline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource WorkOptionTextBoxStyle}" />
                                            <TextBlock Margin="11,0,8,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SettingsPlaceholderBrush}"
                                                       Text="输入新专业">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=NewDisciplineTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="1"
                                                    AutomationProperties.Name="添加人工时专业选项"
                                                    Content="添加"
                                                    Command="{Binding AddWorkDisciplineCommand}"
                                                    Style="{StaticResource WorkOptionAddButtonStyle}" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding WorkDisciplines}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,7,7"
                                                        Padding="9,3,5,3"
                                                        Background="{DynamicResource WorkOptionChipBrush}"
                                                        BorderBrush="{DynamicResource WorkOptionChipBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SettingsChipTextBrush}"
                                                                   Text="{Binding}" />
                                                        <Button AutomationProperties.Name="{Binding StringFormat=移除专业选项 {0}}"
                                                                Command="{Binding DataContext.RemoveWorkDisciplineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="×"
                                                                Style="{StaticResource WorkOptionRemoveButtonStyle}"
                                                                ToolTip="移除该专业选项" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="14"
                                    Background="{DynamicResource WorkOptionPanelBrush}"
                                    BorderBrush="{DynamicResource SettingsGroupBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28"
                                                Height="28"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource SettingsGroupBadgeBrush}"
                                                CornerRadius="6">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SettingsGroupBadgeTextBrush}"
                                                       Text="工" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="工作内容"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="人工时对应的工作类型"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding WorkActivities.Count, StringFormat={}{0} 项}" />
                                    </Grid>

                                    <Border Margin="0,13,0,12"
                                            Style="{StaticResource WorkOptionInputShellStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewActivityTextBox"
                                                     AutomationProperties.Name="新增人工时工作内容选项"
                                                     Text="{Binding NewWorkActivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource WorkOptionTextBoxStyle}" />
                                            <TextBlock Margin="11,0,8,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SettingsPlaceholderBrush}"
                                                       Text="输入新工作内容">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=NewActivityTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="1"
                                                    AutomationProperties.Name="添加人工时工作内容选项"
                                                    Content="添加"
                                                    Command="{Binding AddWorkActivityCommand}"
                                                    Style="{StaticResource WorkOptionAddButtonStyle}" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding WorkActivities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,7,7"
                                                        Padding="9,3,5,3"
                                                        Background="{DynamicResource WorkOptionChipBrush}"
                                                        BorderBrush="{DynamicResource WorkOptionChipBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SettingsChipTextBrush}"
                                                                   Text="{Binding}" />
                                                        <Button AutomationProperties.Name="{Binding StringFormat=移除工作内容选项 {0}}"
                                                                Command="{Binding DataContext.RemoveWorkActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="×"
                                                                Style="{StaticResource WorkOptionRemoveButtonStyle}"
                                                                ToolTip="移除该工作内容选项" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Margin="0,10,0,0"
                                   Text="移除选项不会影响已经保存的人工时记录。"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Padding="18"
                        Margin="0,16,0,0"
                        CornerRadius="10"
                        Background="{DynamicResource SettingsReleaseSurfaceBrush}"
                        BorderBrush="{DynamicResource SettingsReleaseBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="当前策略"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="数据会自动生成在 EXE 所在目录的 data/ 下，便于随程序目录一起备份或迁移。"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="备份页可创建包含数据库、附件和人工时选项 JSON 的 zip 包。"
                                   Margin="0,5,0,0"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
