<UserControl x:Class="KanbanForOne.Controls.KanbanColumnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KanbanForOne.Controls"
             xmlns:models="clr-namespace:KanbanForOne.Models"
             MinWidth="232" Style="{StaticResource {x:Type UserControl}}">
    <Border x:Name="ColumnBorder"
            AllowDrop="True"
            DragEnter="OnDragEnter"
            DragOver="OnDragOver"
            DragLeave="OnDragLeave"
            PreviewDrop="OnPreviewDrop"
            Drop="OnDrop"
            MouseEnter="OnColumnMouseEnter"
            MouseLeave="OnColumnMouseLeave"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10,10,10,12">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource ColumnBackgroundBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsArchiveFilter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="Background" Value="{StaticResource ArchiveColumnBackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <Grid DockPanel.Dock="Top"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="Collapsed" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="20"
                        Height="20"
                        CornerRadius="10"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="#F0F1F3" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsArchiveFilter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="True">
                                    <Setter Property="Background" Value="#F0E9DB" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ElementName=CardItems, Path=Items.Count, Mode=OneWay}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchiveFilter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ArchiveModuleTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Button Grid.Column="3"
                        x:Name="AddButton"
                        Content="+"
                        Click="OnAddButtonClick"
                        Style="{StaticResource IconButtonStyle}"
                        Width="24"
                        MinWidth="24"
                        Height="24"
                        Padding="0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Opacity="0.78"
                        Visibility="{Binding IsArchiveFilter, Converter={StaticResource BooleanToVisibilityConverterEx}, ConverterParameter=Invert}"
                        ToolTip="添加卡片" />
            </Grid>

            <Grid>
                <ListBox x:Name="CardItems"
                         ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         ItemTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Focusable="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLength="1"
                         VirtualizingPanel.CacheLengthUnit="Page">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                    <local:EmptyStateControl x:Name="ColumnEmptyState"
                                             VerticalAlignment="Top"
                                             Title="暂无卡片"
                                             Message="点击右上角 + 添加一张卡片。"
                                             Visibility="Collapsed"
                                             Margin="0,4,0,0"
                                             IsHitTestVisible="False" />

                    <Border x:Name="DropIndicator"
                            Visibility="Collapsed"
                            Height="4"
                            Margin="6,2,6,0"
                            CornerRadius="2"
                            Background="{StaticResource BrandTealBrush}"
                            BorderBrush="{StaticResource BrandTealBrush}"
                            BorderThickness="0"
                            IsHitTestVisible="False"
                            Opacity="0.9"
                            VerticalAlignment="Top">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="2"
                                              Direction="270"
                                              Opacity="0.06" />
                        </Border.Effect>
                    </Border>

                    <Border x:Name="ColumnDropZone"
                            Height="42"
                            Margin="2,12,2,0"
                            CornerRadius="14"
                            Background="#00FFFFFF"
                            BorderBrush="#66CBD5E1"
                            BorderThickness="1"
                            VerticalAlignment="Bottom"
                            Opacity="0.18"
                            IsHitTestVisible="False">
                        <TextBlock Text="拖拽任务到这里"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
