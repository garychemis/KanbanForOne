<UserControl x:Class="KanbanForOne.Controls.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KanbanForOne.Controls"
             xmlns:models="clr-namespace:KanbanForOne.Models">
    <UserControl.Resources>
        <DataTemplate x:Key="TaskCardTemplate">
            <controls:TaskCardControl OpenCommand="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=controls:BoardView}}"
                                      AttachFilesCommand="{Binding DataContext.AttachFilesCommand, RelativeSource={RelativeSource AncestorType=controls:BoardView}}" />
        </DataTemplate>

        <DataTemplate x:Key="NoteCardTemplate">
            <controls:NoteCardControl OpenCommand="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=controls:BoardView}}"
                                      AttachFilesCommand="{Binding DataContext.AttachFilesCommand, RelativeSource={RelativeSource AncestorType=controls:BoardView}}" />
        </DataTemplate>

        <Style x:Key="ArchivePickerButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F3F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource MainContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Visibility="{Binding IsArchiveFilter, Converter={StaticResource BooleanToVisibilityConverterEx}}"
                Background="{StaticResource TopNavBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B8;"
                               FontFamily="{StaticResource AppIconFontFamily}"
                               FontSize="15"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="归档"
                               Margin="8,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 分区选择器 -->
                <Button Grid.Column="1"
                        Command="{Binding OpenArchiveSectionPickerCommand}"
                        Style="{StaticResource ArchivePickerButtonStyle}"
                        Margin="14,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ArchiveSectionSelectorText}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="&#xE70D;"
                                   FontFamily="{StaticResource AppIconFontFamily}"
                                   Margin="10,0,0,1"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </Button>

                <!-- 提示 -->
                <TextBlock Grid.Column="2"
                           Text="{Binding ArchiveSectionSelectorHint}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="BoardScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Padding="16,28,16,28">
            <StackPanel Orientation="Horizontal">
                <controls:KanbanColumnControl Width="240"
                                              MinHeight="{Binding ActualHeight, ElementName=BoardScrollViewer}"
                                              Title="待办"
                                              Subtitle="计划中但尚未开始"
                                              ColumnKind="{x:Static models:KanbanColumnKind.Todo}"
                                              ItemsSource="{Binding TodoTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}"
                                              AddCommand="{Binding CreateTaskCommand}"
                                              AddCommandParameter="{x:Static models:KanbanColumnKind.Todo}"
                                              DropCommand="{Binding MoveCardCommand}"
                                              Margin="0,0,12,0" />

                <controls:KanbanColumnControl Width="240"
                                              MinHeight="{Binding ActualHeight, ElementName=BoardScrollViewer}"
                                              Title="进行中"
                                              Subtitle="当前正在处理"
                                              ColumnKind="{x:Static models:KanbanColumnKind.Doing}"
                                              ItemsSource="{Binding DoingTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}"
                                              AddCommand="{Binding CreateTaskCommand}"
                                              AddCommandParameter="{x:Static models:KanbanColumnKind.Doing}"
                                              DropCommand="{Binding MoveCardCommand}"
                                              Margin="0,0,12,0" />

                <controls:KanbanColumnControl Width="240"
                                              MinHeight="{Binding ActualHeight, ElementName=BoardScrollViewer}"
                                              Title="卡住"
                                              Subtitle="遇到阻碍或等待"
                                              ColumnKind="{x:Static models:KanbanColumnKind.Blocked}"
                                              ItemsSource="{Binding BlockedTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}"
                                              AddCommand="{Binding CreateTaskCommand}"
                                              AddCommandParameter="{x:Static models:KanbanColumnKind.Blocked}"
                                              DropCommand="{Binding MoveCardCommand}"
                                              Margin="0,0,12,0" />

                <controls:KanbanColumnControl Width="240"
                                              MinHeight="{Binding ActualHeight, ElementName=BoardScrollViewer}"
                                              Title="完成"
                                              Subtitle="已经处理完成"
                                              ColumnKind="{x:Static models:KanbanColumnKind.Done}"
                                              ItemsSource="{Binding DoneTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}"
                                              AddCommand="{Binding CreateTaskCommand}"
                                              AddCommandParameter="{x:Static models:KanbanColumnKind.Done}"
                                              DropCommand="{Binding MoveCardCommand}"
                                              Margin="0,0,12,0" />

                <controls:KanbanColumnControl Width="240"
                                              MinHeight="{Binding ActualHeight, ElementName=BoardScrollViewer}"
                                              Title="备忘录"
                                              Subtitle="灵感、备忘和随手记"
                                              ColumnKind="{x:Static models:KanbanColumnKind.Notes}"
                                              ItemsSource="{Binding Notes}"
                                              ItemTemplate="{StaticResource NoteCardTemplate}"
                                              AddCommand="{Binding CreateNoteCommand}"
                                              AddCommandParameter="{x:Static models:KanbanColumnKind.Notes}"
                                              DropCommand="{Binding MoveCardCommand}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
