<UserControl x:Class="KanbanForOne.Controls.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KanbanForOne.Controls"
             xmlns:models="clr-namespace:KanbanForOne.Models" Style="{StaticResource {x:Type UserControl}}">
    <UserControl.Resources>
        <DataTemplate x:Key="TaskCardTemplate">
            <controls:TaskCardControl OpenCommand="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=controls:BoardView}}"
                                      AttachFilesCommand="{Binding DataContext.AttachFilesCommand, RelativeSource={RelativeSource AncestorType=controls:BoardView}}"
                                      RestoreCommand="{Binding DataContext.ArchiveTaskCommand, RelativeSource={RelativeSource AncestorType=controls:BoardView}}"
                                      IsCompact="{Binding DataContext.IsArchiveFilter, RelativeSource={RelativeSource AncestorType=controls:BoardView}}" />
        </DataTemplate>

        <DataTemplate x:Key="NoteCardTemplate">
            <controls:NoteCardControl OpenCommand="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=controls:BoardView}}"
                                      AttachFilesCommand="{Binding DataContext.AttachFilesCommand, RelativeSource={RelativeSource AncestorType=controls:BoardView}}"
                                      RestoreCommand="{Binding DataContext.ArchiveNoteCommand, RelativeSource={RelativeSource AncestorType=controls:BoardView}}"
                                      IsCompact="{Binding DataContext.IsArchiveFilter, RelativeSource={RelativeSource AncestorType=controls:BoardView}}" />
        </DataTemplate>

        <Style x:Key="ArchivePickerButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Opacity="0.06" />
                            </Border.Effect>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MainContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Visibility="{Binding IsArchiveFilter, Converter={StaticResource BooleanToVisibilityConverterEx}}"
                Background="{DynamicResource ArchiveModuleTintBrush}"
                BorderBrush="{DynamicResource ArchiveModuleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B8;"
                               FontFamily="{StaticResource AppIconFontFamily}"
                               FontSize="15"
                               Foreground="{DynamicResource ArchiveModuleTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="归档"
                               Margin="8,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ArchiveModuleTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 分区选择器 -->
                <Button Grid.Column="1"
                        Command="{Binding OpenArchiveSectionPickerCommand}"
                        Style="{StaticResource ArchivePickerButtonStyle}"
                        Margin="14,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ArchiveSectionSelectorText}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="&#xE70D;"
                                   FontFamily="{StaticResource AppIconFontFamily}"
                                   Margin="10,0,0,1"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                </Button>

                <!-- 提示 -->
                <TextBlock Grid.Column="2"
                           Text="{Binding ArchiveSectionSelectorHint}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource ArchiveModuleTextBrush}" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="BoardScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Padding="18,20,18,20">
            <UniformGrid Rows="1" Columns="5" MinWidth="1220" Width="{Binding ViewportWidth, ElementName=BoardScrollViewer}" Height="{Binding ViewportHeight, ElementName=BoardScrollViewer}">
                <controls:KanbanColumnControl Margin="6,0"
                                              Title="待办"
                                              Subtitle="计划中但尚未开始"
                                              IsArchiveFilter="{Binding IsArchiveFilter}"
                                              ColumnKind="{x:Static models:KanbanColumnKind.Todo}"
                                              ItemsSource="{Binding TodoTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}"
                                              AddCommand="{Binding CreateTaskCommand}"
                                              AddCommandParameter="{x:Static models:KanbanColumnKind.Todo}"
                                              DropCommand="{Binding MoveCardCommand}" />

                <controls:KanbanColumnControl Margin="6,0"
                                              Title="进行中"
                                              Subtitle="当前正在处理"
                                              IsArchiveFilter="{Binding IsArchiveFilter}"
                                              ColumnKind="{x:Static models:KanbanColumnKind.Doing}"
                                              ItemsSource="{Binding DoingTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}"
                                              AddCommand="{Binding CreateTaskCommand}"
                                              AddCommandParameter="{x:Static models:KanbanColumnKind.Doing}"
                                              DropCommand="{Binding MoveCardCommand}" />

                <controls:KanbanColumnControl Margin="6,0"
                                              Title="卡住"
                                              Subtitle="遇到阻碍或等待"
                                              IsArchiveFilter="{Binding IsArchiveFilter}"
                                              ColumnKind="{x:Static models:KanbanColumnKind.Blocked}"
                                              ItemsSource="{Binding BlockedTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}"
                                              AddCommand="{Binding CreateTaskCommand}"
                                              AddCommandParameter="{x:Static models:KanbanColumnKind.Blocked}"
                                              DropCommand="{Binding MoveCardCommand}" />

                <controls:KanbanColumnControl Margin="6,0"
                                              Title="完成"
                                              Subtitle="已经处理完成"
                                              IsArchiveFilter="{Binding IsArchiveFilter}"
                                              ColumnKind="{x:Static models:KanbanColumnKind.Done}"
                                              ItemsSource="{Binding DoneTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}"
                                              AddCommand="{Binding CreateTaskCommand}"
                                              AddCommandParameter="{x:Static models:KanbanColumnKind.Done}"
                                              DropCommand="{Binding MoveCardCommand}" />

                <controls:KanbanColumnControl Margin="6,0"
                                              Title="备忘录"
                                              Subtitle="灵感、备忘和随手记"
                                              IsArchiveFilter="{Binding IsArchiveFilter}"
                                              ColumnKind="{x:Static models:KanbanColumnKind.Notes}"
                                              ItemsSource="{Binding Notes}"
                                              ItemTemplate="{StaticResource NoteCardTemplate}"
                                              AddCommand="{Binding CreateNoteCommand}"
                                              AddCommandParameter="{x:Static models:KanbanColumnKind.Notes}"
                                              DropCommand="{Binding MoveCardCommand}" />
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</UserControl>
