<UserControl x:Class="KanbanForOne.Controls.NoteCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KanbanForOne.Controls"
             AllowDrop="True"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             MouseMove="OnMouseMove"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             MouseEnter="OnMouseEnter"
             MouseLeave="OnMouseLeave"
             DragEnter="OnFileDragEnter"
             DragOver="OnFileDragOver"
             DragLeave="OnFileDragLeave"
             Drop="OnFileDrop" Style="{StaticResource {x:Type UserControl}}">
    <Grid>
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="0.08"
                                                     Duration="0:0:0.08" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border x:Name="CardBorder"
                Style="{StaticResource CardBorderStyle}"
                Background="{StaticResource NoteCardBackgroundBrush}"
                BorderBrush="{StaticResource NoteCardBorderBrush}"
                CornerRadius="8"
                MinHeight="88"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="DragScaleTransform"
                                    ScaleX="1"
                                    ScaleY="1" />
                    <RotateTransform x:Name="DragRotateTransform"
                                     Angle="0" />
                    <TranslateTransform x:Name="LiftTransform" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid x:Name="CardContent"
                  Margin="18,16,18,14">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Margin" Value="12,10,12,10" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Title}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource NoteCardTextPrimaryBrush}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="True">
                                    <Setter Property="MaxHeight" Value="34" />
                                    <Setter Property="LineHeight" Value="19" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <controls:MarkdownPreviewControl Markdown="{Binding Content}"
                                                 Grid.Row="1"
                                                 Margin="0,7,0,0"
                                                 PreviewFontSize="12"
                                                 PreviewForeground="{StaticResource NoteCardTextSecondaryBrush}"
                                                 PreviewLineHeight="17"
                                                 PreviewMaxHeight="36">
                    <controls:MarkdownPreviewControl.Style>
                        <Style TargetType="{x:Type controls:MarkdownPreviewControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:MarkdownPreviewControl.Style>
                </controls:MarkdownPreviewControl>

                <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource DateDisplayConverter}, StringFormat=日期 {0}}"
                           Grid.Row="3"
                           Margin="0,10,0,0"
                           FontSize="11"
                           Foreground="{StaticResource NoteCardTextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Row="4"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding TagsDisplay, Converter={StaticResource TagListDisplayConverter}}"
                               FontSize="11"
                               Foreground="{StaticResource NoteCardTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding AttachmentCount, StringFormat=附件 {0}}"
                               Margin="12,0,0,0"
                               FontSize="11"
                               Foreground="{StaticResource NoteCardTextSecondaryBrush}" />
                </Grid>

                <!-- 行内恢复按钮（归档紧凑卡片，悬浮/聚焦显示） -->
                <Button x:Name="InlineRestoreButton"
                        Content="&#xE777;"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="12"
                        ToolTip="恢复"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,2,0"
                        Width="26"
                        Height="26"
                        MinWidth="26"
                        Padding="0"
                        Grid.RowSpan="5"
                        Style="{StaticResource IconButtonStyle}"
                        Opacity="0"
                        Click="OnInlineRestoreClick"
                        Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverterEx}}" />
            </Grid>
        </Border>

        <Border x:Name="DropHint"
                Visibility="Collapsed"
                CornerRadius="8"
                Background="{StaticResource NoteCardBackgroundBrush}"
                BorderBrush="{StaticResource NoteCardHoverBorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock Text="释放文件以保存为附件"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource NoteCardTextPrimaryBrush}" />
        </Border>
    </Grid>
</UserControl>
