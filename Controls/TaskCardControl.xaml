<UserControl x:Class="KanbanForOne.Controls.TaskCardControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KanbanForOne.Controls"
             AllowDrop="True"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             MouseMove="OnMouseMove"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             MouseEnter="OnMouseEnter"
             MouseLeave="OnMouseLeave"
             DragEnter="OnFileDragEnter"
             DragOver="OnFileDragOver"
             DragLeave="OnFileDragLeave"
             Drop="OnFileDrop" Style="{StaticResource {x:Type UserControl}}">
    <Grid>
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="0.08"
                                                     Duration="0:0:0.08" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border x:Name="CardBorder"
                RenderTransformOrigin="0.5,0.5">
            <Border.Style>
                <Style TargetType="{x:Type Border}"
                       BasedOn="{StaticResource CardBorderStyle}">
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="MinHeight" Value="92" />
                    <Setter Property="Background"
                            Value="{Binding Status, Converter={StaticResource TaskStatusBackgroundConverter}}" />
                    <Setter Property="BorderBrush"
                            Value="{Binding Status, Converter={StaticResource TaskStatusBrushConverter}, ConverterParameter=Border}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Done">
                            <Setter Property="MinHeight" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{Binding Status, Converter={StaticResource TaskStatusBrushConverter}}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="DragScaleTransform"
                                    ScaleX="1"
                                    ScaleY="1" />
                    <RotateTransform x:Name="DragRotateTransform"
                                     Angle="0" />
                    <TranslateTransform x:Name="LiftTransform" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid x:Name="CardContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="8,0,0,8">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background"
                                    Value="{Binding Status, Converter={StaticResource TaskStatusBrushConverter}}" />
                        </Style>
                    </Border.Style>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Margin" Value="18,16,18,14" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                    <Setter Property="Margin" Value="18,14,18,14" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="True">
                                    <Setter Property="Margin" Value="12,10,12,10" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground"
                                        Value="{Binding Status, Converter={StaticResource DoneForegroundConverter}}" />
                                <Setter Property="TextDecorations"
                                        Value="{Binding Status, Converter={StaticResource DoneTextDecorationConverter}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="True">
                                        <Setter Property="Margin" Value="0,0,28,0" />
                                        <Setter Property="MaxHeight" Value="34" />
                                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                        <Setter Property="LineHeight" Value="19" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                            <Condition Binding="{Binding Status}" Value="Done" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="MaxHeight" Value="38" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <controls:MarkdownPreviewControl x:Name="HoverPreview"
                                                     Markdown="{Binding Description}"
                                                     Grid.Row="1"
                                                     PreviewFontSize="12"
                                                     PreviewForeground="{Binding Status, Converter={StaticResource TaskStatusBrushConverter}, ConverterParameter=Secondary}"
                                                     PreviewLineHeight="17">
                        <controls:MarkdownPreviewControl.Style>
                            <Style TargetType="{x:Type controls:MarkdownPreviewControl}">
                                <Setter Property="Margin" Value="0,6,0,0" />
                                <Setter Property="PreviewMaxHeight" Value="36" />
                                <Setter Property="IsPreviewExpanded" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=controls:TaskCardControl}}"
                                                 Value="True">
                                        <Setter Property="IsPreviewExpanded" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                        <Setter Property="Margin" Value="0,7,0,0" />
                                        <Setter Property="PreviewMaxHeight" Value="68" />
                                        <Setter Property="IsPreviewExpanded"
                                                Value="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=controls:TaskCardControl}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPreviewExpanded, RelativeSource={RelativeSource Self}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasPreviewContent, RelativeSource={RelativeSource Self}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:MarkdownPreviewControl.Style>
                    </controls:MarkdownPreviewControl>

                    <Grid x:Name="DateMetadata"
                          Grid.Row="3"
                          Margin="0,10,0,0">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=controls:TaskCardControl}}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Status, Converter={StaticResource TaskStatusBrushConverter}, ConverterParameter=Secondary}">
                            <Run Text="日期 " />
                            <Run Text="{Binding DateRangeDisplay, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>

                    <Grid x:Name="PriorityMetadata"
                          Grid.Row="4"
                          Margin="0,7,0,0">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Priority, Converter={StaticResource TaskPriorityNameConverter}, StringFormat=优先级 {0}}"
                                   FontSize="11"
                                   Foreground="{Binding Priority, Converter={StaticResource TaskPriorityBrushConverter}}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Text="超期"
                                   Margin="10,0,0,0"
                                   FontSize="11"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="Visibility"
                                            Value="{Binding IsOverdue, Converter={StaticResource BooleanToVisibilityConverterEx}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding AttachmentCount, StringFormat=附件 {0}}"
                                   Margin="10,0,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{Binding Status, Converter={StaticResource TaskStatusBrushConverter}, ConverterParameter=Secondary}" />
                    </Grid>

                    <Grid x:Name="TagMetadata"
                          Grid.Row="5"
                          Margin="0,10,0,0">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=controls:TaskCardControl}}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="7,3"
                                            Margin="0,0,6,4"
                                            CornerRadius="8"
                                            Background="{DynamicResource HoverBrush}">
                                        <TextBlock Text="{Binding Converter={StaticResource TagDisplayConverter}}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 行内恢复按钮（归档紧凑卡片，悬浮/聚焦显示） -->
                    <Button x:Name="InlineRestoreButton"
                            Content="&#xE777;"
                            FontFamily="{StaticResource AppIconFontFamily}"
                            FontSize="12"
                            ToolTip="恢复"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,2,2,0"
                            Width="26"
                            Height="26"
                            MinWidth="26"
                            Padding="0"
                            Grid.RowSpan="6"
                            Style="{StaticResource IconButtonStyle}"
                            Opacity="0"
                            Click="OnInlineRestoreClick"
                            Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverterEx}}" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="DropHint"
                Visibility="Collapsed"
                CornerRadius="8"
                Background="{DynamicResource SelectedBackgroundBrush}"
                BorderBrush="{DynamicResource BrandTealBrush}"
                BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock Text="释放文件以保存为附件"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" />
        </Border>
    </Grid>
</UserControl>
