<UserControl x:Class="KanbanForOne.Controls.TopNavControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KanbanForOne.Controls" Style="{StaticResource {x:Type UserControl}}">
    <UserControl.Resources>
        <Style x:Key="TopTabButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="TabChrome" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource FilterSelectedBackgroundConverter}"
                                              ConverterParameter="#E3EDE9|#00FFFFFF">
                                    <Binding Path="DataContext.CurrentFilter"
                                             RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="CommandParameter"
                                             RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource BrandTealBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Foreground" Value="#7F1D1D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Background="{StaticResource TopNavBackgroundBrush}">
    <Border Background="{StaticResource TopNavBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0,0,0,1">
        <Grid Height="56" Margin="24,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="看板"
                        Command="{Binding ChangeFilterCommand}"
                        CommandParameter="Board"
                        Style="{StaticResource TopTabButtonStyle}" />
                <Button Content="日历"
                        Command="{Binding ChangeFilterCommand}"
                        CommandParameter="Calendar"
                        Style="{StaticResource TopTabButtonStyle}" />
                <Button Content="人工时汇总"
                        Command="{Binding ChangeFilterCommand}"
                        CommandParameter="WorkHourSummary"
                        Style="{StaticResource TopTabButtonStyle}" />
                <Button Content="设计条件归档"
                        Command="{Binding ChangeFilterCommand}"
                        CommandParameter="DesignConditions"
                        Style="{StaticResource TopTabButtonStyle}" />
            </StackPanel>

            <Border Grid.Column="1" Margin="12,0" Padding="10,6" CornerRadius="6" MaxWidth="160"
                    Background="{StaticResource SelectedBackgroundBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                    VerticalAlignment="Center" ToolTip="{Binding NotificationText}"
                    Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverterEx}}">
                <TextBlock Text="{Binding NotificationText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button Grid.Column="2"
                    AutomationProperties.Name="设置"
                    Content="&#xE713;"
                    Command="{Binding ChangeFilterCommand}"
                    CommandParameter="Settings"
                    FontFamily="{StaticResource AppIconFontFamily}"
                    FontSize="14"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="设置" />

            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="&#xE921;"
                        AutomationProperties.Name="最小化"
                        Click="OnMinimizeClick"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="12"
                        Style="{StaticResource IconButtonStyle}"
                        Width="34"
                        Height="30"
                        ToolTip="最小化" />
                <Button Content="&#xE922;"
                        AutomationProperties.Name="最大化或还原"
                        Click="OnMaximizeClick"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="12"
                        Style="{StaticResource IconButtonStyle}"
                        Width="34"
                        Height="30"
                        Margin="4,0,0,0"
                        ToolTip="最大化/还原" />
                <Button Content="&#xE8BB;"
                        AutomationProperties.Name="关闭"
                        Click="OnCloseClick"
                        FontFamily="{StaticResource AppIconFontFamily}"
                        FontSize="12"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        Width="34"
                        Height="30"
                        Margin="4,0,0,0"
                        ToolTip="关闭到托盘" />
            </StackPanel>
        </Grid>
    </Border>
    <Border Padding="24,12" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1"
            Visibility="{Binding IsWorkspaceFilterVisible, Converter={StaticResource BooleanToVisibilityConverterEx}}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <WrapPanel>
                <controls:SearchBoxControl Width="240" Margin="0,0,12,0"
                                           Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <controls:DateRangeFilterControl StartDate="{Binding DateFilterStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                EndDate="{Binding DateFilterEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                HasFilter="{Binding HasDateFilter}"
                                                ClearCommand="{Binding ClearDateFilterCommand}" />
            </WrapPanel>
        </Grid>
    </Border>
    </StackPanel>
</UserControl>
