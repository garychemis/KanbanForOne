<UserControl x:Class="KanbanForOne.Controls.EmptyStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type UserControl}}">
    <Border Padding="20"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="10"
            Background="{StaticResource SurfaceBrush}">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Margin="0,6,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <Button Margin="0,14,0,0"
                    Command="{Binding ActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding ActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}" />
        </StackPanel>
    </Border>
</UserControl>
