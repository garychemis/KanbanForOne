<UserControl x:Class="KanbanForOne.Controls.MarkdownPreviewControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="False">
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}" BasedOn="{StaticResource {x:Type UserControl}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreviewExpanded, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPreviewContent, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <TextBlock x:Name="PreviewText"
               FontSize="{Binding PreviewFontSize, ElementName=Root}"
               Foreground="{Binding PreviewForeground, ElementName=Root}"
               LineHeight="{Binding PreviewLineHeight, ElementName=Root}"
               MaxHeight="{Binding PreviewMaxHeight, ElementName=Root}"
               LineStackingStrategy="BlockLineHeight"
               ClipToBounds="True"
               TextTrimming="CharacterEllipsis"
               TextWrapping="Wrap" />
</UserControl>
