<UserControl x:Class="KanbanForOne.Controls.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type UserControl}}">
    <Grid Background="{DynamicResource MainContentBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource PageSpacing}"
                        MaxWidth="760"
                        HorizontalAlignment="Left">
            <TextBlock Text="数据备份"
                       Style="{StaticResource AppPageTitleTextStyle}"
                       FontWeight="SemiBold" />
            <TextBlock Text="一次备份全部数据：看板、任务、人工时、设计条件及所有附件。完整 zip 文件保存在 data/backups/。"
                       Margin="0,6,0,22"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <Border Padding="18"
                    CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="当前本地数据"
                               FontSize="14"
                               FontWeight="SemiBold" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数据目录"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DataDirectory}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数据库"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DatabasePath}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="附件目录"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AttachmentDirectory}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="人工时选项" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding WorkHourOptionsPath}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="设计条件库" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding DesignConditionDatabasePath}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="设计条件文件" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding DesignConditionAttachmentDirectory}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="备份目录"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BackupDirectory}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,20,0,0">
                        <Button Content="创建完整备份"
                                Command="{Binding CreateBackupCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="104" />
                        <Button Content="恢复完整备份"
                                Command="{Binding RestoreBackupCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                MinWidth="104"
                                Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="恢复会整体覆盖全部模块数据，执行前自动创建包含当前全部数据的保护备份；任一模块失败会尝试整体回滚。"
                               Margin="0,10,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Padding="14"
                    Margin="0,16,0,0"
                    CornerRadius="10"
                    Background="{DynamicResource BackupSuccessSurfaceBrush}"
                    BorderBrush="{DynamicResource BackupSuccessBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasLastBackup, Converter={StaticResource BooleanToVisibilityConverterEx}}">
                <StackPanel>
                    <TextBlock Text="最近备份"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BackupSuccessTextBrush}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="备份文件"
                                   FontSize="12"
                                   Foreground="{DynamicResource BackupSuccessTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastBackupPath}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource BackupSuccessTextBrush}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="创建时间"
                                   FontSize="12"
                                   Foreground="{DynamicResource BackupSuccessTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastBackupCreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BackupSuccessTextBrush}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="全部附件"
                                   FontSize="12"
                                   Foreground="{DynamicResource BackupSuccessTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastBackupAttachmentCount, StringFormat={}{0} 个}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BackupSuccessTextBrush}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="压缩包大小"
                                   FontSize="12"
                                   Foreground="{DynamicResource BackupSuccessTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastBackupSizeBytes, Converter={StaticResource AttachmentSizeConverter}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BackupSuccessTextBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="14"
                    Margin="0,16,0,0"
                    CornerRadius="10"
                    Background="{DynamicResource BackupWarningSurfaceBrush}"
                    BorderBrush="{DynamicResource BackupWarningBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasLastRestore, Converter={StaticResource BooleanToVisibilityConverterEx}}">
                <StackPanel>
                    <TextBlock Text="最近恢复"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningTextBrush}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="来源备份"
                                   FontSize="12"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastRestoreSourcePath}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="保护备份"
                                   FontSize="12"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastRestoreProtectiveBackupPath}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="恢复时间"
                                   FontSize="12"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastRestoreAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="全部附件"
                                   FontSize="12"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastRestoreAttachmentCount, StringFormat={}{0} 个}"
                                   FontSize="12"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
