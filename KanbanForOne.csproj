<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon\icon-transparent.ico</ApplicationIcon>
    <Version>0.5.2</Version>
    <AssemblyVersion>0.5.2.0</AssemblyVersion>
    <FileVersion>0.5.2.0</FileVersion>
    <InformationalVersion>v0.5.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Kanban41</Product>
    <Authors>闫飞</Authors>
    <Copyright>Copyright © 2026 闫飞</Copyright>
    <ReleaseNotes>
       <![CDATA[v0.5.2|2026-09-24|新增卡片折叠效果，新增暗色模式UI
v0.5.1|2026-09-22|优化了UI
V0.5.0.5|2026-08-27|重构对话框、文件选择与剪贴板为接口并抽取附件事务编排；修复设计条件加载在数据整体恢复时的版本竞态、附件原始文件名被改写及资源管理器定位参数转义问题；补充相应单元测试
V0.5.0.4|2026-08-27|优化了输出excel表格中的数据内容及格式
V0.5.0.3|2026-08-26|设计条件支持在同一记录中维护多种图幅及对应数量；设计条件数据库升级至 V3 并兼容迁移旧数据及备份
V0.5.0.2|2026-08-22|略微优化归档部分UI
V0.5.0.1|2026-08-21|修复可以启动多个进程的问题
V0.5.0|2026-08-19|新增设计条件归档模块，用于管理不同专业之间提交和接收的设计条件；使用独立 DesignConditions.db 和独立附件目录，不修改主数据库；支持项目、提出专业、接收专业、接收人、提出日期、条件名称、版次、图幅和图纸数量录入；提出日期作为唯一日期口径并用于日历展示；支持条件文件上传、打开、定位和删除；新增按项目、提出专业、接收专业和条件名称的图纸量分级汇总，并导出设计条件汇总及明细 Excel；设计条件页面、编辑弹窗和日历详情区统一人工时汇总的控件样式；备份功能合并为完整备份与整体恢复，一次包含看板、任务、人工时、所有附件及设计条件数据，并提供恢复前完整保护备份和失败整体回滚；增强附件保存事务、备份包校验、解压限制和异步错误处理
V0.4.3|2026-08-01|归档页 UI 重做：顶部简化为分区选择器，新建与管理分区统一通过弹窗完成，配色、圆角与整体主题对齐；人工时汇总页 UI 美化：自定义配色全部替换为全局主题色板，面板圆角与柔和投影质感统一；重构主窗口 ViewModel 为按页拆分并引入依赖注入容器，为后续功能扩展打好基础；性能优化：SQLite 启用 WAL 日志模式并优化备份与恢复一致性，修复列表虚拟化，优化看板与日历的刷新算法
V0.4.2|2026-07-23|优化人工时汇总页面结构，时间条件与总工时、原始记录、汇总组合调整为同一行，下方工时分布和汇总明细自适应填满剩余高度；新增按项目、专业、工作内容的组合筛选与级联选项更新，空白项表示不筛选，并同步作用于工时分布和汇总明细；修复筛选下拉菜单无法选中和联动失效问题；统一汇总页字体层级、数字与单位排版、列表与表格行高及数值列对齐，并统一侧栏和顶部导航图标；优化筛选标签居中、下拉框宽度、水平间距和浅绿色底色；设置页内容卡片随窗体宽度自适应伸展，减少右侧空白
V0.4.1|2026-07-22|修复人工时汇总“工时分布”列表的滚动条遮挡文字问题，预留滚动条安全间距；优化任务详情预览态附件区域：显示高度提升至原来的两倍，描述区相应收缩；附件列表采用更紧凑的行距、图标和字号，提高多附件可见数量；设置页更新日志最高占窗体高度的 60%，超出后可在区域内滚动查看
V0.4|2026-07-17|新增个人工时录入与管理，支持项目号、专业、工作内容、工时及可选备注；专业和工作内容使用 data 目录下的 JSON 配置，新增选项自动同步，项目号自动转为大写并移除空格；扩展日历详情区，任务与人工时分区展示，支持新增、查看、编辑和删除当天人工时；新增人工时汇总页面，支持按月自动查询及按日期区间查询，并按项目号、专业、工作内容展示工时分布和汇总明细；新增 Excel 导出，包含汇总和原始明细两个工作表，并记录查询日期范围；优化任务详情弹窗的高度与滚动结构，新建卡片不再默认添加 Inbox 标签；统一人工时录入与汇总页面视觉样式，修复日期、文本框和下拉菜单的显示与遮挡问题；更新透明背景应用图标，并修复窗口与托盘图标资源加载
v0.3.3|2026-06-17|增加超期未完成检查，打开数据时实时判断待办、进行中、卡住卡片是否超期；新增超期未完成筛选入口；在卡片优先级和附件之间显示紫红色“超期”标注；在左侧栏 Kanban41 下方显示版本和版权信息；补充超期判断单元测试并完成构建验证]]></ReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseNotes</_Parameter1>
      <_Parameter2>$(ReleaseNotes)</_Parameter2>
    </AssemblyAttribute>
    <Compile Remove="KanbanForOne.Tests\**\*.cs" />
    <EmbeddedResource Remove="KanbanForOne.Tests\**\*" />
    <None Remove="KanbanForOne.Tests\**\*" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Resource Include="icon\icon-transparent.ico" />
    <Resource Include="icon\icon-transparent.png" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>
