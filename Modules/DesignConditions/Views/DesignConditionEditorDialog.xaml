<Window x:Class="KanbanForOne.Modules.DesignConditions.Views.DesignConditionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KanbanForOne.Controls"
        Title="设计条件详情" Width="780" Height="700" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KanbanForOne;component/Modules/DesignConditions/Views/DesignConditionControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ConditionAttachmentRowStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource ConditionFieldBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ConditionFieldBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="DialogChrome" Margin="14" CornerRadius="18"
            Background="{StaticResource ConditionDialogSurfaceBrush}"
            BorderBrush="{StaticResource ConditionFieldBorderBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.18" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="22,17,16,15" BorderThickness="0">
                <Grid MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="设计条件详情" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource ConditionPrimaryTextBrush}" />
                        <TextBlock Text="记录不同专业之间提交和接收的设计条件" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource ConditionSecondaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Click="OnCloseClick" Style="{StaticResource ConditionCloseButtonStyle}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="22,18,22,12" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False" FocusVisualStyle="{x:Null}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="项目 *" Style="{StaticResource ConditionFieldLabelStyle}" />
                            <TextBox Text="{Binding ProjectNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConditionTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="条件名称 *" Style="{StaticResource ConditionFieldLabelStyle}" />
                            <TextBox Text="{Binding ConditionName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConditionTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,13,0,0">
                            <TextBlock Text="提出专业 *" Style="{StaticResource ConditionFieldLabelStyle}" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding Disciplines}" Text="{Binding IssuingDiscipline, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConditionComboBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,13,0,0">
                            <TextBlock Text="接收专业 *" Style="{StaticResource ConditionFieldLabelStyle}" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding Disciplines}" Text="{Binding ReceivingDiscipline, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConditionComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,13,0,0">
                            <TextBlock Text="接收人 *" Style="{StaticResource ConditionFieldLabelStyle}" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding Receivers}" Text="{Binding Receiver, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConditionComboBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,13,0,0">
                            <TextBlock Text="提出日期 *" Style="{StaticResource ConditionFieldLabelStyle}" />
                            <Border Style="{StaticResource ConditionDateFieldBorderStyle}">
                                <DatePicker SelectedDate="{Binding IssuedDate}" Style="{StaticResource DrawerDatePickerStyle}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,13,0,0">
                            <TextBlock Text="版次" Style="{StaticResource ConditionFieldLabelStyle}" />
                            <TextBox Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConditionTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0" Padding="14" Style="{StaticResource ConditionSurfaceCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="条件图纸 *" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource ConditionSecondaryTextBrush}">
                                        <Run Text="共 " /><Run Text="{Binding DrawingSpecificationCount, Mode=OneWay}" /><Run Text=" 种规格  ·  " />
                                        <Run Text="{Binding TotalDrawingCount, Mode=OneWay}" /><Run Text=" 张" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="＋ 添加规格" Click="OnAddDrawingRowClick"
                                        AutomationProperties.Name="添加条件图幅规格" Style="{StaticResource ConditionGhostButtonStyle}" />
                            </Grid>
                            <Border Style="{StaticResource ConditionDrawingGridChromeStyle}">
                                <DataGrid x:Name="DrawingGrid" ItemsSource="{Binding DrawingRows}" AlternationCount="2"
                                          Style="{StaticResource ConditionDrawingGridStyle}"
                                          AutomationProperties.Name="条件图幅和数量明细">
                                    <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="条件图幅" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding DrawingSize}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox IsEditable="False"
                                                          ItemsSource="{Binding DataContext.DrawingSizes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding DrawingSize, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalContentAlignment="Center"
                                                          AutomationProperties.Name="条件图幅"
                                                          Style="{StaticResource ConditionComboBoxStyle}" Height="34" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="条件数量" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding DrawingCountText}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding DrawingCountText, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Center" TextAlignment="Center" AutomationProperties.Name="条件数量"
                                                         PreviewTextInput="OnDrawingCountPreviewTextInput"
                                                         DataObject.Pasting="OnDrawingCountPasting"
                                                         Style="{StaticResource ConditionTextBoxStyle}" Height="34" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="操作" Width="92" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除" Margin="6,4" HorizontalAlignment="Center"
                                                        AutomationProperties.Name="删除当前图幅规格"
                                                        Command="{Binding DataContext.RemoveDrawingRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource ConditionDrawingDeleteButtonStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0" Padding="14" Style="{StaticResource ConditionSurfaceCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="附件" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Margin="6,0,0,0" Foreground="{StaticResource ConditionSecondaryTextBrush}" FontSize="11">
                                        <Run Text="{Binding Attachments.Count, Mode=OneWay}" /><Run Text=" 个已归档" />
                                        <Run Text="  ·  " /><Run Text="{Binding PendingFilePaths.Count, Mode=OneWay}" /><Run Text=" 个待添加" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="＋ 添加附件" Click="OnAddFilesClick" Style="{StaticResource ConditionGhostButtonStyle}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ConditionAttachmentRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OriginalFileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="已归档附件" Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource ConditionSecondaryTextBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="打开" Click="OnOpenAttachmentClick" Style="{StaticResource ConditionGhostButtonStyle}" Margin="8,0,0,0" MinWidth="48" />
                                                <Button Grid.Column="2" Content="定位" Click="OnRevealAttachmentClick" Style="{StaticResource ConditionGhostButtonStyle}" Margin="4,0,0,0" MinWidth="48" />
                                                <Button Grid.Column="3" Content="移除" Click="OnRemoveAttachmentClick" Style="{StaticResource ConditionGhostButtonStyle}" Margin="4,0,0,0" MinWidth="48" Foreground="#9F1239" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding PendingFilePaths}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ConditionAttachmentRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                                    <TextBlock Text="保存记录后归档" Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource ConditionSecondaryTextBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="取消添加" Click="OnRemovePendingClick" Style="{StaticResource ConditionGhostButtonStyle}" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <controls:AttachmentDropZoneControl Margin="0,8,0,0" MinHeight="56"
                                Owner="{Binding}" AttachFilesCommand="{Binding AttachFilesCommand}"
                                TitleText="拖拽文件到这里添加"
                                HelperText="或点击右上角的“添加附件”选择文件"
                                DropHintText="释放文件以添加到设计条件" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#BE123C" FontSize="12" Margin="2,10,0,0"
                               Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverterEx}}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="22,13" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="删除记录" Click="OnDeleteClick" Visibility="{Binding Source, Converter={StaticResource NullToVisibilityConverter}}"
                            Style="{StaticResource ConditionGhostButtonStyle}" Foreground="#9F1239" />
                    <Button Grid.Column="2" Content="取消" Click="OnCloseClick" Style="{StaticResource ConditionGhostButtonStyle}" />
                    <Button Grid.Column="4" Content="保存" Click="OnSaveClick" Style="{StaticResource ConditionDialogPrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
